{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/404", "destination": "/404.html" }
  ],
  "redirects": [
    { "source": "/ai-individuals", "destination": "/services", "permanent": true },
    { "source": "/ai-individuals.html", "destination": "/services", "permanent": true },
    { "source": "/levels-of-ai", "destination": "/methodology", "permanent": true },
    { "source": "/levels-of-ai.html", "destination": "/methodology", "permanent": true },
    { "source": "/about", "destination": "/company", "permanent": true },
    { "source": "/about.html", "destination": "/company", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\\.min\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)\\.(svg|png|jpg|jpeg|webp|ico|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
